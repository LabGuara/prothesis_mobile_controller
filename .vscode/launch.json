{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "prosthesis_mobile_controller (dev)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "toolArgs": [
                "--dart-define=APP_ENV=dev",
                "--dart-define-from-file=secrets.json"
            ]
        },
        {
            "name": "prosthesis_mobile_controller (dev profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=APP_ENV=dev",
                "--dart-define-from-file=secrets.json"
            ]
        },
        {
            "name": "prosthesis_mobile_controller (dev release mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=APP_ENV=dev",
                "--dart-define-from-file=secrets.json"
            ]
        },
        {
            "name": "command batches (dev)",
            "request": "launch",
            "type": "dart",
            "program": "tool/command_batches.dart",
            "cwd": "${workspaceFolder}",
            "console": "terminal",
            "args": [
                "--env",
                "dev",
                "--batches",
                "100"
            ]
        },
        {
            "name": "command batches (dev, 1 batch)",
            "request": "launch",
            "type": "dart",
            "program": "tool/command_batches.dart",
            "cwd": "${workspaceFolder}",
            "console": "terminal",
            "args": [
                "--env",
                "dev",
                "--batches",
                "1"
            ]
        }
    ]
}
